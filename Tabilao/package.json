{
  "name": "tabilao-anjara",
  "version": "1.0.0",
  "description": "Tabilao Anjara — Fivoriana",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "mg.tabilao.anjara",
    "productName": "Tabilao Anjara",
    "files": ["main.js", "app/**/*"],
    "win": { "target": "portable" },
    "portable": { "artifactName": "Tabilao-Anjara.exe" }
  }
}
